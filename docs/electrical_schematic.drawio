          <mxGeometry height="185" width="185" x="910" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cells" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;3× Li-ion 1500 mAh&lt;/b&gt;&lt;br&gt;соединение: последовательно&lt;br&gt;──────────────────&lt;br&gt;Umin = 9.0 V  (3 × 3.0 V)&lt;br&gt;Unom = 11.1 V  (3 × 3.7 V)&lt;br&gt;Umax = 12.6 V  (3 × 4.2 V)" vertex="1">
          <mxGeometry height="155" width="210" x="1290" y="-135" as="geometry" />
        </mxCell>
        <mxCell id="id1" parent="1" style="shape=mxgraph.electrical.signal_sources.diode;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;rotation=90;" value="&lt;b&gt;Идеальный диод 1&lt;/b&gt;&lt;br&gt;(MOSFET + компаратор)&lt;br&gt;внешнее питание → шина" vertex="1">
