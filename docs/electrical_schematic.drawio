        <mxCell id="ce2" value="GPIO 4/5: UART TX/RX  115200 baud" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;fontSize=10;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" source="esp32" target="tmc2209" parent="1">
