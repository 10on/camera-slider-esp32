        </mxCell>
        <mxCell id="rail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;strokeWidth=3;" value="ОСНОВНАЯ СИЛОВАЯ ШИНА  ~12 – 12.6 V&lt;br&gt;&lt;i&gt;(питается от того источника, у кого выше напряжение)&lt;/i&gt;" vertex="1">
          <mxGeometry height="55" width="780" x="280" y="430" as="geometry" />
        </mxCell>
